# Docker/Postgres defaults for local self-hosted use.
COMPOSE_PROJECT_NAME=crewai-studio-kyber
POSTGRES_USER=crewai_user
POSTGRES_PASSWORD=crewai_secret
POSTGRES_DB=crewai
DB_URL=postgresql://crewai_user:crewai_secret@db:5432/crewai
CREWAI_STUDIO_PORT=8501
CREWAI_STUDIO_DB_PORT=5432

# Generic OpenAI-compatible provider.
# OPENAI_API_KEY="FILL-IN-YOUR-OPENAI-API-KEY"
# OPENAI_API_BASE="OPTIONAL-FILL-IN-YOUR-OPENAI-CUSTOM-BASE/PROXY-URL"
# OPENAI_PROXY_MODELS="openai/gpt4o,openai/gpt4omini,openai/geminiflash,openai/geminipro,openai/claudesonnet35"

# Dedicated OpenRouter cloud provider. Use this for paid cloud escalation models.
OPENROUTER_API_KEY=""
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"
OPENROUTER_MODELS="deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.1-pro-preview-customtools,moonshotai/kimi-k2.6,anthropic/claude-opus-4.7"

# Dedicated Guardian local provider. In Docker, host.docker.internal points back to the Linux host.
GUARDIAN_API_KEY="sk-guardian-local"
GUARDIAN_API_BASE="http://host.docker.internal:11434/v1"
GUARDIAN_MODELS="gemma4-26b-agent,qwen3-35b-reasoning-agent,qwen3-35b-uncensored"

# GROQ_API_KEY="FILL-IN-YOUR-GROQ_API_KEY"
# LMSTUDIO_API_BASE="http://localhost:1234/v1"
# ANTHROPIC_API_KEY="FILL-IN-YOUR-ANTHROPIC_API_KEY"
# AGENTOPS_API_KEY="FILL-IN-YOUR-AGENTOPS_API_KEY"
# XAI_API_KEY="FILL-IN-YOUR-XAI_API_KEY"
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODELS="ollama/llama3.2,ollama/llama3.1,ollama/gemma2,ollama/phi3.5"
# SERPER_API_KEY="your-serper-api-key"
# SCRAPFLY_API_KEY="your-scrapfly-api-key"
AGENTOPS_ENABLED="False"
DEFAULT_LANGUAGE="en"
